# python
__pycache__/
*.pyc

# runtime verification: portable tools, per-client state, raw wire logs.
# Screenshots + result.json + notes.md are kept as evidence.
reference/sab558/runtime/tools/ruffle/
reference/sab558/runtime/state/
reference/sab558/runtime/evidence/*/packets.log
